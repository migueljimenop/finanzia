generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Bank {
  SANTANDER
  FALABELLA
  MERCADO_PAGO
  BANCO_CHILE
}

enum AccountType {
  DEBIT
  CREDIT
}

enum BucketType {
  INVESTMENT
  HOME_TRANSFER
  CREDIT_INSTALLMENT
  AVAILABLE_MARGIN
}

enum CalcMethod {
  PERCENTAGE
  FIXED_AMOUNT
  REMAINDER
}

enum TxType {
  EXPENSE
  INCOME
  TRANSFER
}

enum TxSource {
  MANUAL
  IMPORT
}

/// Cuenta/auth de Better Auth (tabla `account` renombrada para no chocar
/// con el modelo de cuentas bancarias `Account`). Para email+password, la
/// contraseña vive aquí (providerId = "credential").
model AuthAccount {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authAccounts     AuthAccount[]
  sessions         Session[]
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  incomes          Income[]
  distributionRules DistributionRule[]
  documents        Document[]
}

model Account {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  bank          Bank
  type          AccountType
  accountNumber String?
  balance       Decimal     @default(0) @db.Decimal(14, 2)
  currency      String      @default("CLP")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  transactions Transaction[]
  incomes      Income[]
  documents    Document[]

  @@unique([userId, bank, accountNumber])
  @@index([userId])
}

model Category {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  kind     TxType
  isSystem Boolean @default(false)

  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  type        TxType
  source      TxSource @default(MANUAL)
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@index([accountId, date])
}

model DistributionRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  buckets DistributionBucket[]
  incomes Income[]

  @@index([userId])
}

model DistributionBucket {
  id              String     @id @default(cuid())
  ruleId          String
  rule            DistributionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  type            BucketType
  calcMethod      CalcMethod
  value           Decimal?   @db.Decimal(14, 2)
  targetAccountId String?
  order           Int

  distributions IncomeDistribution[]
}

model Income {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  accountId   String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  ruleId      String
  rule        DistributionRule @relation(fields: [ruleId], references: [id])
  createdAt   DateTime @default(now())

  distributions IncomeDistribution[]

  @@index([userId, date])
}

model IncomeDistribution {
  id       String   @id @default(cuid())
  incomeId String
  income   Income   @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  bucketId String
  bucket   DistributionBucket @relation(fields: [bucketId], references: [id])
  type     BucketType
  amount   Decimal  @db.Decimal(14, 2)

  @@index([incomeId])
}

/// Cartola subida. `storedName` es la referencia al archivo guardado en
/// disco (uploads/); pertenece a un usuario y opcionalmente a una cuenta.
model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  originalName String
  storedName String   @unique
  mime       String?
  size       Int
  bank       Bank?
  rowCount   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
}